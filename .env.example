# URL da API Backend
VITE_API_URL=http://localhost:20262

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Facebook Pixel (opcional — vazio/descomentado = pixel desactivado)
VITE_FACEBOOK_PIXEL_ID=

# Moeda dos eventos de valor (padrão: AOA — kwanza)
VITE_FACEBOOK_PIXEL_CURRENCY=AOA
